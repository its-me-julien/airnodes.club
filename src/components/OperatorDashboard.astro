---
const points = [
  { month: "Aug ’25", value: 552, x: 58, y: 222 },
  { month: "Sep ’25", value: 579, x: 154, y: 208 },
  { month: "Oct ’25", value: 582, x: 250, y: 207 },
  { month: "Nov ’25", value: 588, x: 346, y: 203 },
  { month: "Dec ’25", value: 601, x: 442, y: 197 },
  { month: "Jan ’26", value: 614, x: 538, y: 191 },
  { month: "Feb ’26", value: 609, x: 634, y: 193 },
  { month: "Mar ’26", value: 621, x: 730, y: 187 },
  { month: "Apr ’26", value: 647, x: 826, y: 175 },
  { month: "May ’26", value: 884, x: 922, y: 70 },
  { month: "Jun ’26", value: 901, x: 1018, y: 62 },
  { month: "Jul ’26", value: 893, x: 1114, y: 66 },
] as const;

const linePath = "M58 222 C90 222 124 208 154 208 C186 208 218 207 250 207 C282 207 314 203 346 203 C378 203 410 197 442 197 C474 197 506 191 538 191 C570 191 602 193 634 193 C666 193 698 187 730 187 C762 187 794 175 826 175 C862 175 888 70 922 70 C954 70 986 62 1018 62 C1050 62 1082 66 1114 66";
const areaPath = `${linePath} L1114 246 L58 246 Z`;

const nodeTypes = [
  { name: "Frontier Plus", count: 3, color: "#df4f69" },
  { name: "Frontier Core", count: 5, color: "#ee6679" },
  { name: "Ember", count: 21, color: "#ef9850" },
  { name: "Spark", count: 313, color: "#3fc293" },
] as const;

const activity = [
  { kind: "purchase", title: "Node purchase", detail: "Purchased 2× EmberNode Stack", date: "8 days ago", label: "Purchase", amount: "" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed February 2026 earnings", date: "18/03/2026", label: "Claim", amount: "US$681.30" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed December 2025 earnings", date: "21/01/2026", label: "Claim", amount: "US$744.90" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed October 2025 earnings", date: "14/11/2025", label: "Claim", amount: "US$619.80" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed August 2025 earnings", date: "22/09/2025", label: "Claim", amount: "US$703.25" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed July 2025 earnings", date: "19/08/2025", label: "Claim", amount: "US$532.10" },
] as const;
---

<div class="dashboard-intro">
  <p class="dashboard-kicker">Operator overview</p>
  <h3>Dashboard</h3>
  <p>Track your AirNode performance, network activity and rewards.</p>
</div>

<div class="dashboard-summary-grid">
  <section class="dashboard-panel dashboard-rewards-card" aria-labelledby="pending-rewards-title">
    <header class="dashboard-panel-head">
      <h3 id="pending-rewards-title">Pending rewards</h3>
      <p>Earnings ready to be claimed</p>
    </header>
    <p class="pending-reward"><strong>US$735</strong></p>
    <div class="dashboard-claim-button">Claim rewards</div>
  </section>

  <section class="dashboard-panel dashboard-performance-card" aria-labelledby="performance-overview-title">
    <header class="dashboard-panel-head">
      <h3 id="performance-overview-title">Performance overview</h3>
      <p>Earnings and data transfer trends</p>
    </header>
    <dl class="performance-stats">
      <div><dt>Total earnings</dt><dd>US$12,486.35</dd></div>
      <div><dt>Total data transferred</dt><dd>936.42 TB</dd></div>
    </dl>
  </section>
</div>

<div class="dashboard-overview">
  <section class="dashboard-panel node-breakdown" aria-labelledby="node-breakdown-title">
    <header class="dashboard-panel-head">
      <h3 id="node-breakdown-title">Node breakdown</h3>
      <p>Your AirNode distribution by type</p>
    </header>
    <dl class="node-legend">
      {nodeTypes.map((node) => (
        <div>
          <dt><i style={`--node-color:${node.color}`}></i>{node.name}</dt>
          <dd>{node.count}</dd>
        </div>
      ))}
    </dl>
    <div class="node-donut" role="img" aria-label="313 Spark, 21 Ember, 5 Frontier Core and 3 Frontier Plus AirNodes">
      <span>342<small>AirNodes</small></span>
    </div>
    <div class="dashboard-ghost-button">My AirNodes <span aria-hidden="true">→</span></div>
  </section>

  <section class="dashboard-panel recent-activity" aria-labelledby="recent-activity-title">
    <header class="dashboard-panel-head">
      <h3 id="recent-activity-title">Recent activity</h3>
      <p>Latest transactions and events</p>
    </header>
    <ol class="activity-list">
      {activity.map((item) => (
        <li>
          <span class="activity-icon" aria-hidden="true">
            {item.kind === "purchase" ? (
              <svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L20.5 8H6.1M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" /></svg>
            ) : (
              <svg viewBox="0 0 24 24"><path d="M4 10h16v10H4V10Zm8 0v10M3 7h18v3H3V7Zm9 0H7.8A2.8 2.8 0 1 1 12 4.6V7Zm0 0h4.2A2.8 2.8 0 1 0 12 4.6V7Z" /></svg>
            )}
          </span>
          <div class="activity-copy">
            <strong>{item.title}</strong>
            <span>{item.detail}</span>
            <time>{item.date}</time>
          </div>
          <div class="activity-value">
            <span>{item.label}</span>
            {item.amount && <strong>{item.amount}</strong>}
          </div>
        </li>
      ))}
    </ol>
    <div class="dashboard-ghost-button">See all <span aria-hidden="true">→</span></div>
  </section>
</div>

<div class="operator-dashboard" aria-label="Illustrative AirNode operator dashboard">
  <div class="dashboard-head">
    <div>
      <p class="dashboard-eyebrow">Operator dashboard</p>
      <h3>Monthly earnings</h3>
      <p class="dashboard-summary">Last 12 months <span>·</span> Total: US$8,071.00 <span>·</span> Avg: US$672.58</p>
    </div>
    <div class="dashboard-periods" aria-label="Selected chart period">
      <span>3M</span><span>6M</span><span>9M</span><strong>1Y</strong><span>All</span>
    </div>
  </div>

  <div class="dashboard-chart" aria-hidden="true">
    <svg viewBox="0 0 1180 292" role="img">
      <defs>
        <linearGradient id="earnings-fill" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#ffdf00" stop-opacity=".19" />
          <stop offset="100%" stop-color="#ffdf00" stop-opacity="0" />
        </linearGradient>
      </defs>
      {[40, 92, 144, 196, 246].map((y) => <line x1="58" y1={y} x2="1114" y2={y} class="chart-gridline" />)}
      {["$1,000", "$900", "$800", "$700", "$600"].map((label, index) => (
        <text x="0" y={45 + index * 52} class="chart-axis-value">{label}</text>
      ))}
      <path d={areaPath} fill="url(#earnings-fill)" />
      <path d={linePath} class="chart-line" />
      {points.map((point) => <circle cx={point.x} cy={point.y} r="5" class="chart-point" />)}
      {points.map((point) => <text x={point.x} y="278" text-anchor="middle" class="chart-month">{point.month}</text>)}
    </svg>
  </div>

  <div class="dashboard-mobile-list">
    {points.slice(-4).map((point) => (
      <div><span>{point.month}</span><strong>US${point.value}</strong></div>
    ))}
  </div>

  <p class="dashboard-note">Illustrative dashboard preview. Figures shown are examples, not guaranteed rewards.</p>

  <table class="sr-only">
    <caption>Illustrative monthly AirNode earnings</caption>
    <thead><tr><th>Month</th><th>Earnings</th></tr></thead>
    <tbody>{points.map((point) => <tr><td>{point.month}</td><td>US${point.value}</td></tr>)}</tbody>
  </table>
</div>
