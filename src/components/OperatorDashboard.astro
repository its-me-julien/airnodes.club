---
const points = [
  { month: "Aug ’25", value: 552, x: 58, y: 222 }, { month: "Sep ’25", value: 579, x: 154, y: 208 },
  { month: "Oct ’25", value: 582, x: 250, y: 207 }, { month: "Nov ’25", value: 588, x: 346, y: 203 },
  { month: "Dec ’25", value: 601, x: 442, y: 197 }, { month: "Jan ’26", value: 614, x: 538, y: 191 },
  { month: "Feb ’26", value: 609, x: 634, y: 193 }, { month: "Mar ’26", value: 621, x: 730, y: 187 },
  { month: "Apr ’26", value: 647, x: 826, y: 175 }, { month: "May ’26", value: 884, x: 922, y: 70 },
  { month: "Jun ’26", value: 901, x: 1018, y: 62 }, { month: "Jul ’26", value: 893, x: 1114, y: 66 },
] as const;
const linePath = "M58 222 C90 222 124 208 154 208 C186 208 218 207 250 207 C282 207 314 203 346 203 C378 203 410 197 442 197 C474 197 506 191 538 191 C570 191 602 193 634 193 C666 193 698 187 730 187 C762 187 794 175 826 175 C862 175 888 70 922 70 C954 70 986 62 1018 62 C1050 62 1082 66 1114 66";
const areaPath = `${linePath} L1114 246 L58 246 Z`;
const portfolio = [
  { name: "#Frontier-b7c42", type: "Frontier", tone: "frontier", location: "#harbor-signal-lantern", total: "US$57.00", month: "US$57.00" },
  { name: "#Ember-91fd3", type: "Ember", tone: "ember", location: "#valley-bridge-orbit", total: "US$9.90", month: "US$3.30" },
  { name: "#Spark-a1aa1", type: "Spark", tone: "spark", location: "#market-river-signal", total: "US$5.10", month: "US$1.70" },
] as const;
---

<div class="dashboard-preview-label">
  <span>Illustrative operator dashboard</span>
  <p>Example data demonstrates the operator experience. Figures are not guaranteed rewards.</p>
</div>

<div class="dashboard-summary-grid">
  <section class="dashboard-panel dashboard-rewards-card" aria-labelledby="pending-rewards-title">
    <header class="dashboard-panel-head"><h3 id="pending-rewards-title">Pending rewards</h3><p>Earnings ready to be claimed</p></header>
    <p class="pending-reward"><strong>US$735</strong></p>
    <div class="dashboard-demo-action" aria-hidden="true">Claim rewards</div>
  </section>
  <section class="dashboard-panel dashboard-performance-card" aria-labelledby="performance-overview-title">
    <header class="dashboard-panel-head"><h3 id="performance-overview-title">Performance overview</h3><p>Earnings and data transfer trends</p></header>
    <dl class="performance-stats"><div><dt>Total earnings</dt><dd>US$12,486.35</dd></div><div><dt>Total data transferred</dt><dd>936.42 TB</dd></div></dl>
  </section>
</div>

<section class="dashboard-portfolio dashboard-panel" aria-labelledby="portfolio-title">
  <header class="dashboard-panel-head portfolio-head">
    <div><p class="dashboard-eyebrow">Your infrastructure</p><h3 id="portfolio-title">Explore your AirNode portfolio</h3><p>See how every AirNode is performing in one place.</p></div>
    <span>{portfolio.length} examples shown</span>
  </header>
  <div class="portfolio-mobile-list">
    {portfolio.map((node) => (
      <article>
        <div><strong>{node.name}</strong><span class={`portfolio-type portfolio-type-${node.tone}`}>{node.type}</span></div>
        <code>{node.location}</code>
        <dl><div><dt>Total earned</dt><dd>{node.total}</dd></div><div><dt>This month</dt><dd>{node.month}</dd></div></dl>
      </article>
    ))}
  </div>
  <div class="portfolio-table-wrap">
    <table class="portfolio-table">
      <thead><tr><th>AirNode</th><th>Type</th><th>Location</th><th>Total earned</th><th>Est. this month</th></tr></thead>
      <tbody>{portfolio.map((node) => <tr><th scope="row">{node.name}</th><td><span class={`portfolio-type portfolio-type-${node.tone}`}>{node.type}</span></td><td class="portfolio-location"><code>{node.location}</code></td><td class="portfolio-earned">{node.total}</td><td>{node.month}</td></tr>)}</tbody>
    </table>
  </div>
</section>

<div class="operator-dashboard" aria-label="Illustrative monthly AirNode earnings">
  <div class="dashboard-head">
    <div><p class="dashboard-eyebrow">Operator dashboard</p><h3>Monthly earnings</h3><p class="dashboard-summary">Last 12 months <span>·</span> Total: US$8,071.00 <span>·</span> Avg: US$672.58</p></div>
    <div class="dashboard-periods" aria-label="Selected chart period"><span>3M</span><span>6M</span><span>9M</span><strong>1Y</strong><span>All</span></div>
  </div>
  <div class="dashboard-chart" aria-hidden="true">
    <svg viewBox="0 0 1180 292" role="img">
      <defs><linearGradient id="earnings-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#ffdf00" stop-opacity=".19" /><stop offset="100%" stop-color="#ffdf00" stop-opacity="0" /></linearGradient></defs>
      {[40, 92, 144, 196, 246].map((y) => <line x1="58" y1={y} x2="1114" y2={y} class="chart-gridline" />)}
      {["$1,000", "$900", "$800", "$700", "$600"].map((label, index) => <text x="0" y={45 + index * 52} class="chart-axis-value">{label}</text>)}
      <path d={areaPath} fill="url(#earnings-fill)" /><path d={linePath} class="chart-line" />
      {points.map((point) => <circle cx={point.x} cy={point.y} r="5" class="chart-point" />)}
      {points.map((point) => <text x={point.x} y="278" text-anchor="middle" class="chart-month">{point.month}</text>)}
    </svg>
  </div>
  <div class="dashboard-mobile-list">{points.slice(-4).map((point) => <div><span>{point.month}</span><strong>US${point.value}</strong></div>)}</div>
  <table class="sr-only"><caption>Illustrative monthly AirNode earnings</caption><thead><tr><th>Month</th><th>Earnings</th></tr></thead><tbody>{points.map((point) => <tr><td>{point.month}</td><td>US${point.value}</td></tr>)}</tbody></table>
</div>
