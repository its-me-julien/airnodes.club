---
const points = [
  { month: "Aug ’25", value: 548, x: 58, y: 224 },
  { month: "Sep ’25", value: 581, x: 154, y: 207 },
  { month: "Oct ’25", value: 580, x: 250, y: 207 },
  { month: "Nov ’25", value: 584, x: 346, y: 205 },
  { month: "Dec ’25", value: 603, x: 442, y: 196 },
  { month: "Jan ’26", value: 611, x: 538, y: 192 },
  { month: "Feb ’26", value: 612, x: 634, y: 192 },
  { month: "Mar ’26", value: 614, x: 730, y: 191 },
  { month: "Apr ’26", value: 632, x: 826, y: 182 },
  { month: "May ’26", value: 919, x: 922, y: 54 },
  { month: "Jun ’26", value: 916, x: 1018, y: 55 },
  { month: "Jul ’26", value: 928, x: 1114, y: 49 },
] as const;

const linePath = "M58 224 C90 224 124 207 154 207 C186 207 218 207 250 207 C282 207 314 205 346 205 C378 205 410 196 442 196 C474 196 506 192 538 192 C570 192 602 192 634 192 C666 192 698 191 730 191 C762 191 794 182 826 182 C862 182 888 54 922 54 C954 54 986 55 1018 55 C1050 55 1082 49 1114 49";
const areaPath = `${linePath} L1114 246 L58 246 Z`;

const nodeTypes = [
  { name: "Frontier Plus", count: 1, color: "#df4f69" },
  { name: "Frontier Core", count: 2, color: "#ee6679" },
  { name: "Ember", count: 17, color: "#ef9850" },
  { name: "Spark", count: 515, color: "#3fc293" },
] as const;

const activity = [
  { kind: "purchase", title: "Node purchase", detail: "Purchased 3× Frontier Core Stack", date: "5 days ago", label: "Purchase", amount: "" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed January 2026 earnings", date: "27/02/2026", label: "Claim", amount: "US$800.70" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed December 2025 earnings", date: "02/02/2026", label: "Claim", amount: "US$792.20" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed September 2025 earnings", date: "02/11/2025", label: "Claim", amount: "US$756.50" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed August 2025 earnings", date: "30/09/2025", label: "Claim", amount: "US$722.50" },
  { kind: "claim", title: "Rewards claimed", detail: "Claimed July 2025 earnings", date: "29/08/2025", label: "Claim", amount: "US$564.40" },
] as const;
---

<div class="dashboard-overview">
  <section class="dashboard-panel node-breakdown" aria-labelledby="node-breakdown-title">
    <header class="dashboard-panel-head">
      <h3 id="node-breakdown-title">Node breakdown</h3>
      <p>Your AirNode distribution by type</p>
    </header>
    <dl class="node-legend">
      {nodeTypes.map((node) => (
        <div>
          <dt><i style={`--node-color:${node.color}`}></i>{node.name}</dt>
          <dd>{node.count}</dd>
        </div>
      ))}
    </dl>
    <div class="node-donut" role="img" aria-label="515 Spark, 17 Ember, 2 Frontier Core and 1 Frontier Plus AirNodes">
      <span>535<small>AirNodes</small></span>
    </div>
    <div class="dashboard-ghost-button">My AirNodes <span aria-hidden="true">→</span></div>
  </section>

  <section class="dashboard-panel recent-activity" aria-labelledby="recent-activity-title">
    <header class="dashboard-panel-head">
      <h3 id="recent-activity-title">Recent activity</h3>
      <p>Latest transactions and events</p>
    </header>
    <ol class="activity-list">
      {activity.map((item) => (
        <li>
          <span class="activity-icon" aria-hidden="true">
            {item.kind === "purchase" ? (
              <svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L20.5 8H6.1M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" /></svg>
            ) : (
              <svg viewBox="0 0 24 24"><path d="M4 10h16v10H4V10Zm8 0v10M3 7h18v3H3V7Zm9 0H7.8A2.8 2.8 0 1 1 12 4.6V7Zm0 0h4.2A2.8 2.8 0 1 0 12 4.6V7Z" /></svg>
            )}
          </span>
          <div class="activity-copy">
            <strong>{item.title}</strong>
            <span>{item.detail}</span>
            <time>{item.date}</time>
          </div>
          <div class="activity-value">
            <span>{item.label}</span>
            {item.amount && <strong>{item.amount}</strong>}
          </div>
        </li>
      ))}
    </ol>
    <div class="dashboard-ghost-button">See all <span aria-hidden="true">→</span></div>
  </section>
</div>

<div class="operator-dashboard" aria-label="Illustrative AirNode operator dashboard">
  <div class="dashboard-head">
    <div>
      <p class="dashboard-eyebrow">Operator dashboard</p>
      <h3>Monthly earnings</h3>
      <p class="dashboard-summary">Last 12 months <span>·</span> Total: US$8,134.88 <span>·</span> Avg: US$677.91</p>
    </div>
    <div class="dashboard-periods" aria-label="Selected chart period">
      <span>3M</span><span>6M</span><span>9M</span><strong>1Y</strong><span>All</span>
    </div>
  </div>

  <div class="dashboard-chart" aria-hidden="true">
    <svg viewBox="0 0 1180 292" role="img">
      <defs>
        <linearGradient id="earnings-fill" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#ffdf00" stop-opacity=".19" />
          <stop offset="100%" stop-color="#ffdf00" stop-opacity="0" />
        </linearGradient>
      </defs>
      {[40, 92, 144, 196, 246].map((y) => <line x1="58" y1={y} x2="1114" y2={y} class="chart-gridline" />)}
      {["$1,000", "$900", "$800", "$700", "$600"].map((label, index) => (
        <text x="0" y={45 + index * 52} class="chart-axis-value">{label}</text>
      ))}
      <path d={areaPath} fill="url(#earnings-fill)" />
      <path d={linePath} class="chart-line" />
      {points.map((point) => <circle cx={point.x} cy={point.y} r="5" class="chart-point" />)}
      {points.map((point) => <text x={point.x} y="278" text-anchor="middle" class="chart-month">{point.month}</text>)}
    </svg>
  </div>

  <div class="dashboard-mobile-list">
    {points.slice(-4).map((point) => (
      <div><span>{point.month}</span><strong>US${point.value}</strong></div>
    ))}
  </div>

  <p class="dashboard-note">Illustrative dashboard preview. Figures shown are examples, not guaranteed rewards.</p>

  <table class="sr-only">
    <caption>Illustrative monthly AirNode earnings</caption>
    <thead><tr><th>Month</th><th>Earnings</th></tr></thead>
    <tbody>{points.map((point) => <tr><td>{point.month}</td><td>US${point.value}</td></tr>)}</tbody>
  </table>
</div>
