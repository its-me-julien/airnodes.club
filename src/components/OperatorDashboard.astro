---
const months = ["Jun ’26", "Jul ’26", "Aug ’26"] as const;

const illustrativeEconomics = {
  spark: { unitCost: 63, monthlyReward: 1.7 },
  ember: { unitCost: 165, monthlyReward: 3.3 },
  frontier: {
    unitCost: 1940,
    monthlyReward: 58.5,
  },
} as const;

const airnodes = [
  { id: "frontier", name: "#Frontier-b7c42", type: "Frontier", tone: "frontier", activeSince: "June 2026", rewards: [illustrativeEconomics.frontier.monthlyReward, illustrativeEconomics.frontier.monthlyReward, illustrativeEconomics.frontier.monthlyReward] },
  { id: "ember", name: "#Ember-91fd3", type: "EmberNode", tone: "ember", activeSince: "June 2026", rewards: [illustrativeEconomics.ember.monthlyReward, illustrativeEconomics.ember.monthlyReward, illustrativeEconomics.ember.monthlyReward] },
  { id: "spark", name: "#Spark-a1aa1", type: "Spark", tone: "spark", activeSince: "June 2026", rewards: [illustrativeEconomics.spark.monthlyReward, illustrativeEconomics.spark.monthlyReward, illustrativeEconomics.spark.monthlyReward] },
] as const;

const sum = (values: readonly number[]) => values.reduce((total, value) => total + value, 0);
const formatMoney = (value: number) => `$${value.toFixed(2)}`;
const allRewards = months.map((_, monthIndex) => sum(airnodes.map((node) => node.rewards[monthIndex])));
const totalRewards = sum(allRewards);
const pendingRewards = allRewards.at(-1) ?? 0;

const chartLeft = 74;
const chartRight = 1104;
const chartTop = 30;
const chartBottom = 230;
const chartMax = 70;
const chartX = months.map((_, index) => chartLeft + (index * (chartRight - chartLeft)) / (months.length - 1));
const chartY = (value: number) => chartBottom - (value / chartMax) * (chartBottom - chartTop);
const chartPoints = allRewards.map((value, index) => ({ month: months[index], value, x: chartX[index], y: chartY(value) }));
const linePath = chartPoints.map((point, index) => `${index === 0 ? "M" : "L"}${point.x} ${point.y}`).join(" ");
const areaPath = `${linePath} L${chartRight} ${chartBottom} L${chartLeft} ${chartBottom} Z`;
const axisValues = [70, 52.5, 35, 17.5, 0];
const axisY = axisValues.map((_, index) => chartTop + (index * (chartBottom - chartTop)) / (axisValues.length - 1));
const dashboardData = { months, airnodes: airnodes.map(({ id, type, rewards }) => ({ id, type, rewards })) };
const plannerProducts = [
  { id: "spark", name: "Spark", tone: "spark", unitCost: illustrativeEconomics.spark.unitCost, monthlyReward: illustrativeEconomics.spark.monthlyReward },
  { id: "ember", name: "EmberNode", tone: "ember", unitCost: illustrativeEconomics.ember.unitCost, monthlyReward: illustrativeEconomics.ember.monthlyReward },
  { id: "frontier", name: "Frontier Max", tone: "frontier", unitCost: illustrativeEconomics.frontier.unitCost, monthlyReward: illustrativeEconomics.frontier.monthlyReward },
] as const;
const plannerInitialCost = sum(plannerProducts.map((product) => product.unitCost));
const plannerInitialReward = sum(plannerProducts.map((product) => product.monthlyReward));
const plannerInitialRoi = (plannerInitialReward * 12 / plannerInitialCost) * 100;
const plannerData = { products: plannerProducts };
---

<div class="dashboard-preview-label">
  <span>Illustrative operator dashboard</span>
  <p>Example data demonstrates the operator experience.</p>
</div>

<div class="dashboard-experience" data-operator-dashboard>
  <script is:inline type="application/json" data-dashboard-source set:html={JSON.stringify(dashboardData)}></script>

  <div class="dashboard-summary-grid">
    <section class="dashboard-panel dashboard-rewards-card" aria-labelledby="available-rewards-title">
      <header class="dashboard-panel-head"><h3 id="available-rewards-title">Pending rewards</h3><p>From August 2026 service · ready to claim</p></header>
      <p class="pending-reward"><strong data-pending-rewards>{formatMoney(pendingRewards)}</strong></p>
      <button class="dashboard-demo-action" type="button" disabled>Claim rewards</button>
    </section>
    <section class="dashboard-panel dashboard-performance-card" aria-labelledby="performance-overview-title">
      <header class="dashboard-panel-head"><h3 id="performance-overview-title">Performance overview</h3><p>Rewards and network activity for the selected AirNodes</p></header>
      <dl class="performance-stats">
        <div><dt>Total earnings</dt><dd data-total-earnings>{formatMoney(totalRewards)}</dd></div>
      </dl>
    </section>
  </div>

  <section class="dashboard-portfolio dashboard-panel" aria-labelledby="portfolio-title">
    <header class="dashboard-panel-head portfolio-head">
      <div><p class="dashboard-eyebrow">Your infrastructure</p><h3 id="portfolio-title">AirNode portfolio</h3></div>
      <span data-active-airnodes>{airnodes.length} active AirNodes</span>
    </header>
    <div class="portfolio-mobile-list">
      {airnodes.map((node) => (
        <article data-node-row={node.id}>
          <div><strong>{node.name}</strong><span class={`portfolio-type portfolio-type-${node.tone}`}>{node.type}</span></div>
          <p class="portfolio-active-since">Active since {node.activeSince} <span data-node-units={node.id}>· 1 unit</span></p>
          <dl><div><dt>Total earned</dt><dd data-node-total={node.id}>{formatMoney(sum(node.rewards))}</dd></div><div><dt>This month</dt><dd data-node-monthly={node.id}>{formatMoney(node.rewards.at(-1) ?? 0)}</dd></div></dl>
        </article>
      ))}
    </div>
    <div class="portfolio-table-wrap">
      <table class="portfolio-table">
        <thead><tr><th>AirNode</th><th>Type</th><th>Units</th><th>Active since</th><th>Total earned</th><th>Est. this month</th></tr></thead>
        <tbody>{airnodes.map((node) => <tr data-node-row={node.id}><th scope="row">{node.name}</th><td><span class={`portfolio-type portfolio-type-${node.tone}`}>{node.type}</span></td><td data-node-units={node.id}>1 unit</td><td>{node.activeSince}</td><td class="portfolio-earned" data-node-total={node.id}>{formatMoney(sum(node.rewards))}</td><td data-node-monthly={node.id}>{formatMoney(node.rewards.at(-1) ?? 0)}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <div class="operator-dashboard" aria-label="Illustrative monthly AirNode earnings">
    <div class="dashboard-head">
      <div><p class="dashboard-eyebrow">Portfolio performance</p><h3>Monthly earnings</h3><p class="dashboard-summary" data-chart-summary>3 months <span>·</span> 3 AirNodes <span>·</span> Total: {formatMoney(totalRewards)} <span>·</span> Avg: {formatMoney(totalRewards / months.length)}</p></div>
      <div class="dashboard-periods" role="group" aria-label="Filter chart by AirNode">
        <button type="button" data-node-filter="all" aria-pressed="true">All</button>
        {airnodes.map((node) => <button type="button" data-node-filter={node.id} aria-pressed="false">{node.type}</button>)}
      </div>
    </div>
    <div class="dashboard-chart" aria-hidden="true">
      <svg viewBox="0 0 1180 292" role="img">
        <defs><linearGradient id="earnings-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#ffdf00" stop-opacity=".19" /><stop offset="100%" stop-color="#ffdf00" stop-opacity="0" /></linearGradient></defs>
        {axisY.map((y) => <line x1={chartLeft} y1={y} x2={chartRight} y2={y} class="chart-gridline" />)}
        {axisValues.map((value, index) => <text x="0" y={axisY[index] + 5} class="chart-axis-value" data-chart-axis>{formatMoney(value)}</text>)}
        <path d={areaPath} fill="url(#earnings-fill)" data-chart-area /><path d={linePath} class="chart-line" data-chart-line />
        {chartPoints.map((point) => <circle cx={point.x} cy={point.y} r="5" class="chart-point" data-chart-point />)}
        {chartPoints.map((point) => <text x={point.x} y="278" text-anchor="middle" class="chart-month">{point.month}</text>)}
      </svg>
    </div>
    <div class="dashboard-mobile-list">{chartPoints.map((point) => <div><span>{point.month}</span><strong data-mobile-value>{formatMoney(point.value)}</strong></div>)}</div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-dashboard-live></p>
    <table class="sr-only" data-earnings-table><caption>Illustrative monthly AirNode earnings for all AirNodes</caption><thead><tr><th>Month</th><th>Earnings</th></tr></thead><tbody>{chartPoints.map((point) => <tr><td>{point.month}</td><td>{formatMoney(point.value)}</td></tr>)}</tbody></table>
  </div>

  <section class="opportunity-planner" data-opportunity-planner aria-labelledby="opportunity-planner-title">
    <script is:inline type="application/json" data-planner-source set:html={JSON.stringify(plannerData)}></script>
    <header class="opportunity-planner-head">
      <div>
        <p class="planner-status">Illustrative planning tool</p>
        <h3 id="opportunity-planner-title">Explore a possible AirNode mix.</h3>
        <p>Adjust the units to update this illustrative dashboard, including its rewards, history and portfolio.</p>
      </div>
      <div class="planner-tools"><p class="planner-limit">1–10 units per AirNode</p><button type="button" data-planner-reset>Reset mix</button></div>
    </header>

    <div class="opportunity-planner-layout">
      <div class="planner-controls">
        {plannerProducts.map((product) => (
          <div class={`planner-control planner-control-${product.tone}`}>
            <div class="planner-control-head">
              <label for={`planner-${product.id}`}>{product.name}</label>
              <output for={`planner-${product.id}`} data-planner-units={product.id}>1 unit</output>
            </div>
            <input id={`planner-${product.id}`} name={product.id} type="range" min="1" max="10" value="1" step="1" data-planner-input={product.id} />
            <div class="planner-range-labels" aria-hidden="true"><span>1</span><span>10</span></div>
            <p>Approx. {formatMoney(product.unitCost)} per unit · <span data-planner-unit-reward={product.id}>{formatMoney(product.monthlyReward)}</span> / month per unit</p>
          </div>
        ))}
      </div>

      <aside class="planner-results" aria-label="Opportunity estimate">
        <dl>
          <div><dt>Total cost</dt><dd data-planner-cost>{formatMoney(plannerInitialCost)}</dd></div>
          <div><dt>Est. monthly rewards</dt><dd data-planner-reward>{formatMoney(plannerInitialReward)}</dd></div>
          <div><dt>Approx. annualised ROI*</dt><dd data-planner-roi>{plannerInitialRoi.toFixed(1)}%</dd></div>
        </dl>
        <p>*Calculated as estimated monthly rewards × 12 ÷ approximate upfront cost. It excludes purchase discounts, operating costs, tax, downtime and variations in rewards.</p>
      </aside>
    </div>
  </section>
</div>

<script>
  type DashboardNode = { id: string; type: string; rewards: number[] };
  type DashboardSource = { months: string[]; airnodes: DashboardNode[] };
  const formatDashboardMoney = (value: number) => `$${value.toFixed(2)}`;

  document.querySelectorAll<HTMLElement>("[data-operator-dashboard]").forEach((dashboard) => {
    const sourceElement = dashboard.querySelector<HTMLScriptElement>("[data-dashboard-source]");
    if (!sourceElement?.textContent) return;
    const source = JSON.parse(sourceElement.textContent) as DashboardSource;
    const filters = dashboard.querySelectorAll<HTMLButtonElement>("[data-node-filter]");
    const chartLine = dashboard.querySelector<SVGPathElement>("[data-chart-line]");
    const chartArea = dashboard.querySelector<SVGPathElement>("[data-chart-area]");
    const chartPoints = dashboard.querySelectorAll<SVGCircleElement>("[data-chart-point]");
    const mobileValues = dashboard.querySelectorAll<HTMLElement>("[data-mobile-value]");
    const chartSummary = dashboard.querySelector<HTMLElement>("[data-chart-summary]");
    const liveRegion = dashboard.querySelector<HTMLElement>("[data-dashboard-live]");
    const earningsTable = dashboard.querySelector<HTMLTableElement>("[data-earnings-table]");
    const pendingOutput = dashboard.querySelector<HTMLElement>("[data-pending-rewards]");
    const totalEarningsOutput = dashboard.querySelector<HTMLElement>("[data-total-earnings]");
    const activeAirnodesOutput = dashboard.querySelector<HTMLElement>("[data-active-airnodes]");
    const chartLeft = 74, chartRight = 1104, chartTop = 30, chartBottom = 230;
    let chartMax = 70;
    const xPositions = source.months.map((_, index) => chartLeft + (index * (chartRight - chartLeft)) / (source.months.length - 1));
    const yPosition = (value: number) => chartBottom - (value / chartMax) * (chartBottom - chartTop);
    let quantities = new Map(source.airnodes.map((node) => [node.id, 1]));
    let selectedId = "all";
    const plannedNodes = () => source.airnodes.map((node) => {
      const quantity = quantities.get(node.id) ?? 1;
      return { ...node, rewards: node.rewards.map((reward) => reward * quantity) };
    });

    const selectNode = (nextSelectedId: string) => {
      const nodes = plannedNodes();
      const selectedNodes = nextSelectedId === "all" ? nodes : nodes.filter((node) => node.id === nextSelectedId);
      if (selectedNodes.length === 0) return;
      selectedId = nextSelectedId;
      const rewards = source.months.map((_, monthIndex) => selectedNodes.reduce((total, node) => total + node.rewards[monthIndex], 0));
      const total = rewards.reduce((sum, value) => sum + value, 0);
      const selectionLabel = nextSelectedId === "all" ? "All AirNodes" : selectedNodes[0].type;
      const selectedUnits = selectedNodes.reduce((sum, node) => sum + (quantities.get(node.id) ?? 1), 0);
      const nodeLabel = selectedUnits === 1 ? "1 AirNode" : `${selectedUnits} AirNodes`;
      const points = rewards.map((value, index) => ({ x: xPositions[index], y: yPosition(value) }));
      const linePath = points.map((point, index) => `${index === 0 ? "M" : "L"}${point.x} ${point.y}`).join(" ");
      const areaPath = `${linePath} L${chartRight} ${chartBottom} L${chartLeft} ${chartBottom} Z`;

      if (chartSummary) chartSummary.innerHTML = `3 months <span>·</span> ${nodeLabel} <span>·</span> Total: ${formatDashboardMoney(total)} <span>·</span> Avg: ${formatDashboardMoney(total / source.months.length)}`;
      if (chartLine) { chartLine.setAttribute("d", linePath); chartLine.classList.remove("is-updating"); void chartLine.getBoundingClientRect(); chartLine.classList.add("is-updating"); }
      chartArea?.setAttribute("d", areaPath);
      chartPoints.forEach((point, index) => { point.setAttribute("cx", String(points[index].x)); point.setAttribute("cy", String(points[index].y)); });
      mobileValues.forEach((element, index) => { element.textContent = formatDashboardMoney(rewards[index]); });
      filters.forEach((filter) => filter.setAttribute("aria-pressed", String(filter.dataset.nodeFilter === nextSelectedId)));
      dashboard.querySelectorAll<HTMLElement>("[data-node-row]").forEach((row) => row.classList.toggle("is-selected", nextSelectedId !== "all" && row.dataset.nodeRow === nextSelectedId));

      if (earningsTable) {
        const caption = earningsTable.querySelector("caption");
        if (caption) caption.textContent = `Illustrative monthly AirNode earnings for ${selectionLabel}`;
        earningsTable.querySelectorAll<HTMLTableRowElement>("tbody tr").forEach((row, index) => { const valueCell = row.cells[1]; if (valueCell) valueCell.textContent = formatDashboardMoney(rewards[index]); });
      }
      if (liveRegion) liveRegion.textContent = `${selectionLabel}: ${formatDashboardMoney(total)} total earnings over three months.`;
    };

    const updateDashboard = () => {
      const nodes = plannedNodes();
      const rewards = source.months.map((_, monthIndex) => nodes.reduce((total, node) => total + node.rewards[monthIndex], 0));
      const total = rewards.reduce((sum, value) => sum + value, 0);
      const activeAirnodes = Array.from(quantities.values()).reduce((sum, quantity) => sum + quantity, 0);
      chartMax = Math.max(70, Math.ceil(Math.max(...rewards) / 10) * 10);
      if (pendingOutput) pendingOutput.textContent = formatDashboardMoney(rewards.at(-1) ?? 0);
      if (totalEarningsOutput) totalEarningsOutput.textContent = formatDashboardMoney(total);
      if (activeAirnodesOutput) activeAirnodesOutput.textContent = `${activeAirnodes} active AirNodes`;
      dashboard.querySelectorAll<HTMLElement>("[data-chart-axis]").forEach((element, index) => {
        element.textContent = formatDashboardMoney(chartMax - (chartMax * index) / 4);
      });
      nodes.forEach((node) => {
        const quantity = quantities.get(node.id) ?? 1;
        const nodeTotal = node.rewards.reduce((sum, value) => sum + value, 0);
        const nodeMonthly = node.rewards.at(-1) ?? 0;
        dashboard.querySelectorAll<HTMLElement>(`[data-node-units="${node.id}"]`).forEach((element) => { element.textContent = `${quantity} ${quantity === 1 ? "unit" : "units"}`; });
        dashboard.querySelectorAll<HTMLElement>(`[data-node-total="${node.id}"]`).forEach((element) => { element.textContent = formatDashboardMoney(nodeTotal); });
        dashboard.querySelectorAll<HTMLElement>(`[data-node-monthly="${node.id}"]`).forEach((element) => { element.textContent = formatDashboardMoney(nodeMonthly); });
      });
      selectNode(selectedId);
    };

    filters.forEach((filter) => filter.addEventListener("click", () => {
      selectedId = filter.dataset.nodeFilter ?? "all";
      selectNode(selectedId);
    }));
    window.addEventListener("illustrative-plan-change", ((event: CustomEvent<Record<string, number>>) => {
      quantities = new Map(Object.entries(event.detail));
      updateDashboard();
    }) as EventListener);
  });

  type PlannerProduct = { id: string; unitCost: number; monthlyReward: number };
  type PlannerSource = { products: PlannerProduct[] };

  document.querySelectorAll<HTMLElement>("[data-opportunity-planner]").forEach((planner) => {
    const sourceElement = planner.querySelector<HTMLScriptElement>("[data-planner-source]");
    if (!sourceElement?.textContent) return;
    const source = JSON.parse(sourceElement.textContent) as PlannerSource;
    const inputs = planner.querySelectorAll<HTMLInputElement>("[data-planner-input]");
    const costOutput = planner.querySelector<HTMLElement>("[data-planner-cost]");
    const rewardOutput = planner.querySelector<HTMLElement>("[data-planner-reward]");
    const roiOutput = planner.querySelector<HTMLElement>("[data-planner-roi]");
    const resetButton = planner.querySelector<HTMLButtonElement>("[data-planner-reset]");

    const updatePlanner = () => {
      const units = new Map(Array.from(inputs, (input) => [input.dataset.plannerInput, Number(input.value)]));
      const totals = source.products.reduce((result, product) => {
        const quantity = units.get(product.id) ?? 1;
        const unitOutput = planner.querySelector<HTMLOutputElement>(`[data-planner-units="${product.id}"]`);
        const unitReward = planner.querySelector<HTMLElement>(`[data-planner-unit-reward="${product.id}"]`);
        if (unitOutput) unitOutput.textContent = `${quantity} ${quantity === 1 ? "unit" : "units"}`;
        if (unitReward) unitReward.textContent = formatDashboardMoney(product.monthlyReward);
        return {
          cost: result.cost + quantity * product.unitCost,
          reward: result.reward + quantity * product.monthlyReward,
        };
      }, { cost: 0, reward: 0 });
      const roi = (totals.reward * 12 / totals.cost) * 100;
      if (costOutput) costOutput.textContent = formatDashboardMoney(totals.cost);
      if (rewardOutput) rewardOutput.textContent = formatDashboardMoney(totals.reward);
      if (roiOutput) roiOutput.textContent = `${roi.toFixed(1)}%`;
      window.dispatchEvent(new CustomEvent("illustrative-plan-change", { detail: Object.fromEntries(units) }));
    };

    inputs.forEach((input) => input.addEventListener("input", updatePlanner));
    resetButton?.addEventListener("click", () => {
      inputs.forEach((input) => { input.value = "1"; });
      updatePlanner();
    });
  });
</script>
