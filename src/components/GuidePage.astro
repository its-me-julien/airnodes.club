---
import BrandMark from "./BrandMark.astro";
import SiteFooter from "./SiteFooter.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../config";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  facts: readonly { readonly label: string; readonly value: string }[];
  sections: readonly { readonly title: string; readonly body: string }[];
}

const { title, description, eyebrow, heading, intro, facts, sections } = Astro.props;
---

<Layout title={title} description={description}>
  <header class="site-header">
    <nav class="shell nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="Airnodes Club home"><BrandMark /></a>
      <div class="nav-links"><a href="/airnodes/">AirNodes</a><a href="/deployment-regions/philippines/">Regions</a><a href="/airnode-affiliate-code/">Affiliate code</a></div>
      <a class="button button-small button-primary" href={site.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer">Explore AirNodes <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="main-content" class="guide-page">
    <section class="guide-hero">
      <div class="shell guide-hero-inner">
        <div><p class="section-index">{eyebrow}</p><h1>{heading}</h1></div>
        <div class="guide-intro"><p>{intro}</p><a class="button button-light" href={site.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer">Explore with code {site.affiliateCode} <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section class="section shell guide-content">
      <dl class="guide-facts">{facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
      <div class="guide-sections">{sections.map((section, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{section.title}</h2><p>{section.body}</p></div></article>)}</div>
      <aside class="guide-cta"><p>World Mobile AirNode affiliate code</p><strong>{site.affiliateCode}</strong><a class="button button-primary" href={site.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer">Explore AirNodes with code {site.affiliateCode} <span aria-hidden="true">↗</span></a><small>Airnodes Club is independent from World Mobile. We may receive a commission after a qualifying first order through our referral link.</small></aside>
    </section>
  </main>
  <SiteFooter />
</Layout>
