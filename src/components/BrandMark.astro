---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["brand-lockup", { compact }]}>
  <svg aria-hidden="true" viewBox="0 0 52 52">
    <path class="mark-signal" d="M14 19c7.5-9 20.5-9 28 0"></path>
    <circle class="mark-node" cx="28" cy="22" r="3.5"></circle>
    <path class="mark-mast" d="M28 27v17M20 44h16"></path>
  </svg>
  <span class="brand-name">Airnodes <span>Club</span></span>
</span>
