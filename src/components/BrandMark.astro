---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["brand-lockup", { compact }]}>
  <svg aria-hidden="true" viewBox="0 0 52 52">
    <path class="mark-site" d="M7 47V25C7 13.4 16.4 4 28 4s21 9.4 21 21v22"></path>
    <path class="mark-mast" d="M28 47V24M20 47h16"></path>
    <circle class="mark-node" cx="28" cy="19" r="3"></circle>
    <path class="mark-signal" d="M19.5 14.5a12 12 0 0 1 17 0M23 18a7 7 0 0 1 10 0"></path>
  </svg>
  <span class="brand-name">Airnodes <span>Club</span></span>
</span>
