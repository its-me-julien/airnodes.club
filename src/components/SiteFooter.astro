---
import BrandMark from "./BrandMark.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-brand-row">
      <a class="brand" href="/" aria-label="Airnodes Club home">
        <BrandMark compact />
      </a>
      <a class="back-to-top" href="#top">
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/airnodes/">AirNodes</a>
      <a href="/airnode-affiliate-code/">Affiliate code</a>
      <a href="/deployment-regions/pakistan/">Pakistan</a>
      <a href="/deployment-regions/philippines/">Philippines</a>
    </nav>

    <div class="footer-info">
      <p class="footer-disclaimer">
        Independent guide. Not operated by, endorsed by or part of World Mobile.
        Educational and marketing content only. This is not financial, tax or legal advice.
        AirNode ownership carries risk, and earnings may be zero.
      </p>
      <p class="footer-copyright">© {year} Airnodes Club</p>
    </div>
  </div>
</footer>
