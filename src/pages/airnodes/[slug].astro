---
import GuidePage from "../../components/GuidePage.astro";
export const prerender = true;

export function getStaticPaths() {
const guides = {
  spark: { name:"Spark", title:"World Mobile Spark AirNode: Price and Rewards | Airnodes Club", description:"Understand the World Mobile Spark AirNode, its Pakistan deployment, price and current reward structure.", intro:"Spark is an accessible AirNode at the edge of the Pakistan network. It creates local Wi-Fi coverage where people, homes and businesses connect.", facts:[{label:"Service",value:"Local Wi-Fi coverage"},{label:"Region",value:"Pakistan"},{label:"Availability",value:"Distribution partners only"},{label:"Price",value:"From $62.99"},{label:"Historic reward reference†",value:"$1.70 / month"}], sections:[{title:"Connectivity at the edge",body:"Spark sits close to the people using the network and provides Wi-Fi coverage within its local area."},{title:"Remote operator experience",body:"Operators own the AirNode and follow its performance and rewards through the World Mobile operator dashboard."},{title:"Reward structure under current terms",body:"Current programme terms describe the reward structure for an active, eligible AirNode. Amounts, eligibility and programme terms can change."}]},
  embernode: { name:"EmberNode", title:"World Mobile EmberNode: Price and Rewards | Airnodes Club", description:"Understand the World Mobile EmberNode, its Pakistan distribution role, price and traffic-linked rewards.", intro:"EmberNode operates at the distribution layer in Pakistan, moving capacity from the fibre backbone toward the edge of the network.", facts:[{label:"Service",value:"Network data distribution"},{label:"Region",value:"Pakistan"},{label:"Price",value:"From $165"},{label:"Historic reward reference†",value:"About $3.33 / month"}], sections:[{title:"Own more of the network path",body:"EmberNode supports the flow of connectivity through cabinets and fibre infrastructure before it reaches edge devices."},{title:"Built for Pakistan",body:"World Mobile works with WorldCall as network capacity expands across cities including Islamabad, Lahore, Faisalabad and Multan."},{title:"Rewards follow verified traffic",body:"Eligible rewards depend on the verified network traffic carried by the AirNode under current platform terms."}]},
  frontier: { name:"Frontier", title:"World Mobile Frontier AirNode Philippines | Airnodes Club", description:"Explore the World Mobile Frontier AirNode, Philippines deployment, pricing tiers and reward structure.", intro:"Frontier delivers fibre-backed business Wi-Fi in the Philippines, beginning around General Luna and Cloud 9 in Siargao.", facts:[{label:"Service",value:"Business Wi-Fi"},{label:"Region",value:"Philippines"},{label:"Price",value:"From $585"},{label:"Historic reward reference†",value:"$17.55–$58.50 / month"}], sections:[{title:"Business connectivity first",body:"Each active Frontier deployment begins with a business location that needs reliable connectivity for daily operations."},{title:"Local deployment",body:"World Mobile’s local partners manage customer relationships, installation and network operations while Operators monitor remotely."},{title:"Tier-based reward structure",body:"Current programme terms describe the structure for an active, eligible AirNode. Amounts, eligibility and programme terms can change."}]},
  portal: { name:"Portal", title:"World Mobile Portal AirNode USA: Price and Rewards | Airnodes Club", description:"Understand the World Mobile Portal AirNode, USA coverage role, price and usage-linked reward expectations.", intro:"Portal is professionally deployed on eligible elevated sites to provide wide-area connectivity across neighbourhoods, businesses and public spaces.", facts:[{label:"Service",value:"Wide-area coverage"},{label:"Region",value:"USA"},{label:"Price",value:"From $9,000"},{label:"Historic reward reference†",value:"About $250–$500 / month"}], sections:[{title:"Neighbourhood-scale coverage",body:"Portal uses rooftops, towers and other elevated locations to strengthen coverage and add network capacity."},{title:"Professionally deployed",body:"Operators can use a World Mobile-sourced location or pursue an eligible site, depending on current deployment terms."},{title:"Rewards follow real use",body:"Eligible rewards are linked to connected subscribers and the network activity generated in the Portal coverage area."}]},
} as const;
return Object.entries(guides).map(([slug, props]) => ({ params:{slug}, props }));
}
const guide = Astro.props;
---
<GuidePage title={guide.title} description={guide.description} eyebrow={`${guide.name} AirNode`} heading={`Own a ${guide.name} AirNode.`} intro={guide.intro} facts={guide.facts} sections={guide.sections} />
