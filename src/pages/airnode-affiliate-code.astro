---
import GuidePage from "../components/GuidePage.astro";
import { site } from "../config";
---
<GuidePage
  title={`World Mobile AirNode Affiliate Code ${site.affiliateCode} | Airnodes Club`}
  description={`Use World Mobile AirNode affiliate code ${site.affiliateCode}. The code is applied automatically through the Airnodes Club referral link.`}
  eyebrow="World Mobile AirNode affiliate code"
  heading={`AirNode affiliate code ${site.affiliateCode}.`}
  intro="Use our referral link to continue to World Mobile’s official AirNode platform. Code JWBMLA is included automatically, so you can compare current models and review the final offer directly with World Mobile."
  facts={[{label:"Affiliate code",value:site.affiliateCode},{label:"Applied",value:"Automatically through our link"},{label:"Checkout",value:"World Mobile"}]}
  path={["Open our referral link",`Code ${site.affiliateCode} is applied`,"Review AirNodes on World Mobile"]}
  sections={[{title:"One code, applied automatically",body:`Every purchase link on Airnodes Club uses the World Mobile referral URL containing code ${site.affiliateCode}. You do not need to copy and paste it before exploring the current AirNode selection.`},{title:"Compare before choosing",body:"AirNodes serve different parts of the telecom network and vary significantly in price, deployment region, operator profile and reward model. Start with the role you want to play, then compare the current terms."},{title:"Complete your order with World Mobile",body:"Airnodes Club provides independent educational and marketing content. World Mobile displays current availability, eligibility, pricing and the Operator agreement before an order is completed."}]}
  related={[{href:"/airnodes/",label:"Compare AirNodes",description:"Review models, prices, services and reward mechanisms."},{href:"/deployment-regions/pakistan/",label:"Pakistan deployment",description:"See how EmberNode and Spark support the network path."},{href:"/deployment-regions/philippines/",label:"Philippines deployment",description:"Understand the Frontier rollout in Siargao."}]}
  ctaLabel={`Explore with code ${site.affiliateCode}`}
  parent={{href:"/airnodes/",label:"AirNodes"}}
/>
