---
import { Image } from "astro:assets";
import BrandMark from "../components/BrandMark.astro";
import heroImage from "../assets/airnode-operator.png";
import Layout from "../layouts/Layout.astro";
import { products, site, sources } from "../config";

const steps = [
  {
    number: "01",
    title: "Choose an AirNode",
    body: "Compare its network role, approved market, operating model and current terms.",
  },
  {
    number: "02",
    title: "Buy and sign",
    body: "Complete World Mobile’s checkout and sign the current Operator agreement.",
  },
  {
    number: "03",
    title: "Deploy and activate",
    body: "The equipment is installed and activated. Who handles each step depends on the model and agreement.",
  },
  {
    number: "04",
    title: "Track and claim",
    body: "Monitor status, usage and eligible rewards through the AirNode platform dashboard.",
  },
] as const;

const risks = [
  {
    title: "Demand and traffic",
    body: "Usage-based rewards depend on verified network demand. Planning benchmarks are not usage commitments.",
  },
  {
    title: "Activation and uptime",
    body: "Rewards may not begin until activation and can pause when service, connectivity or a customer location is unavailable.",
  },
  {
    title: "Operating partners",
    body: "World Mobile and the AirNode platform govern measurement and payout; approved local partners may handle deployment and operations.",
  },
  {
    title: "Hardware and location",
    body: "Physical equipment can fail, be damaged, become obsolete or require relocation and maintenance.",
  },
  {
    title: "Regulation and terms",
    body: "Telecom rules, product terms, reward rates and availability can change by country and over time.",
  },
  {
    title: "Liquidity and capital",
    body: "Do not assume a resale market or instant exit. Capital may be locked for an uncertain period or lost.",
  },
] as const;

const faqs = [
  {
    question: "What do I own when I buy an AirNode?",
    answer:
      "World Mobile describes AirNodes as physical telecom infrastructure you own. The model-specific agreement determines legal title, hosting, operation, transfer rights and obligations. You are not buying equity in World Mobile, spectrum, land or a guaranteed income stream.",
  },
  {
    question: "Do I install the hardware?",
    answer:
      "It depends on the model. EmberNode is pre-installed and platform-managed. World Mobile says approved local partners install and operate Frontier deployments in the Philippines. Other products may require a suitable site or a different operating arrangement.",
  },
  {
    question: "Are rewards fixed?",
    answer:
      "Not across all models. EmberNode rewards follow verified data throughput. World Mobile’s published Frontier terms describe a monthly base reward while the matched customer service is active. Other models have their own terms, and rewards can be lower than illustrations—or zero.",
  },
  {
    question: "Can I deploy an AirNode anywhere?",
    answer:
      "No. Each product is designed for an approved market, network role and operating model. Buying an AirNode does not give permission to place equipment in an arbitrary country or location.",
  },
  {
    question: "Are the reward examples net income?",
    answer:
      "No. They are gross illustrations based on World Mobile’s published assumptions. They exclude taxes, fees, currency conversion, financing, downtime and other model-specific costs.",
  },
  {
    question: "What happens when I click Buy AirNodes?",
    answer:
      "You leave this independent guide. World Mobile provides live availability, eligibility, contracts, checkout and the platform account. Airnodes Club does not hold your funds, sell the equipment or determine your rewards.",
  },
] as const;

const firstPartySources = [
  ["AirNodes overview and current catalogue", sources.airnodes],
  ["EmberNode product and economics", sources.ember],
  ["Frontier product and reward model", sources.frontier],
  ["Frontier Philippines announcement", sources.frontierAnnouncement],
  ["Frontier launch post on X", sources.frontierSocial],
  ["AirNode platform", sources.platform],
  ["Network scale milestone", sources.scale],
  ["Affiliate programme launch terms", sources.affiliate],
] as const;

const contextSources = [
  ["HexyNodes market context", sources.hexy],
  ["World Mobile Alliance offers", sources.alliance],
  ["Legacy infrastructure knowledge base", sources.legacy],
] as const;
---

<Layout
  title="Airnodes Club — Own telecom infrastructure"
  description="A clear, independent guide to World Mobile AirNodes: what the equipment does, who operates it, how eligible rewards work and what to check before you buy."
>
  <header class="site-header">
    <nav class="shell nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="Airnodes Club home">
        <BrandMark />
      </a>
      <div class="nav-links">
        <a href="#start">Start here</a>
        <a href="#how-it-works">How it works</a>
        <a href="#airnodes">AirNodes</a>
        <a href="#rewards">Rewards</a>
        <a href="#risks">Risks</a>
      </div>
      <a
        class="button button-small button-primary"
        href={site.affiliateUrl}
        target="_blank"
        rel="sponsored noopener noreferrer"
      >
        Buy AirNodes <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-kicker">Independent guide to World Mobile AirNodes</p>
        <h1 id="hero-title">Own telecom infrastructure. Help more people connect.</h1>
        <p class="hero-lede">
          AirNodes are physical equipment inside World Mobile’s network. Compare
          what each model does, who operates it and how eligible rewards work
          before you buy.
        </p>
        <div class="hero-actions">
          <a
            class="button button-light"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy AirNodes <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="micro-disclosure">
          Independent affiliate guide. We may earn a commission from qualifying
          purchases.
        </p>
      </div>
      <figure class="hero-media">
        <Image
          src={heroImage}
          alt="A network technician working beside outdoor telecom equipment above a neighbourhood"
          widths={[720, 960, 1280, 1600]}
          sizes="(max-width: 860px) 100vw, 55vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Illustrative image. AirNode hardware and deployment vary by model and market.
        </figcaption>
      </figure>
    </section>

    <section class="section intro-section shell" id="start" aria-labelledby="start-title">
      <div class="section-heading">
        <div>
          <p class="section-index">01 / Start here</p>
          <h2 id="start-title">A different way to build a mobile network.</h2>
        </div>
        <p class="section-lede">
          World Mobile combines telecom infrastructure with independent ownership
          and local operations. More people can participate in building the
          network—not only traditional telecom companies.
        </p>
      </div>

      <div class="definition-list">
        <article>
          <p class="definition-label">World Mobile</p>
          <div>
            <h3>The network</h3>
            <p>
              World Mobile coordinates mobile and internet services, the AirNode
              platform and operating partners across approved markets.
            </p>
          </div>
        </article>
        <article>
          <p class="definition-label">AirNode</p>
          <div>
            <h3>The physical infrastructure</h3>
            <p>
              One AirNode may distribute capacity, connect a business, extend
              coverage or support the network backbone. The role changes by model.
            </p>
          </div>
        </article>
        <article>
          <p class="definition-label">Operator</p>
          <div>
            <h3>The owner</h3>
            <p>
              World Mobile calls an AirNode owner an Operator. The agreement says
              who deploys the equipment, who runs it and how eligible rewards are calculated.
            </p>
          </div>
        </article>
      </div>

      <div class="ownership-statement">
        <p>You own the infrastructure.</p>
        <p>The product agreement defines who deploys and operates it.</p>
      </div>
    </section>

    <section class="journey-section" id="how-it-works" aria-labelledby="journey-title">
      <div class="shell">
        <div class="journey-heading">
          <p class="section-index">02 / How it works</p>
          <h2 id="journey-title">From choosing to claiming—in four steps.</h2>
        </div>
        <ol class="journey-list">
          {
            steps.map((step) => (
              <li>
                <span class="step-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
        <div class="reward-logic">
          <p class="reward-logic-title">Rewards follow qualifying service—not ownership alone.</p>
          <div>
            <p><strong>Usage-linked</strong> EmberNode rewards follow verified traffic.</p>
            <p><strong>Service-linked</strong> Published Frontier terms use an active customer service.</p>
          </div>
        </div>
        <p class="payout-note">
          World Mobile says eligible rewards are managed through the AirNode
          dashboard. Timing, minimum claims, payout methods and fees are subject to
          current platform terms.
          <a href={sources.airnodes} target="_blank" rel="noopener noreferrer">Check the official details ↗</a>
        </p>
      </div>
    </section>

    <section class="section product-section" id="airnodes" aria-labelledby="airnodes-title">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="section-index">03 / The options</p>
            <h2 id="airnodes-title">Choose by role—not headline return.</h2>
          </div>
          <p class="section-lede">
            “AirNode” is an umbrella, not one product. Compare the network role,
            market, operating model and reward basis before comparing price.
          </p>
        </div>

        <div class="product-ledger">
          {
            products.map((product) => (
              <details class="product-row">
                <summary>
                  <div class="product-name">
                    <h3>{product.name}</h3>
                    <span>{product.status}</span>
                  </div>
                  <div class="product-layer">
                    <span class="cell-label">Role and market</span>
                    <strong>{product.layer}</strong>
                  </div>
                  <div class="product-economics">
                    <span class="cell-label">Published price</span>
                    <strong>{product.price}</strong>
                  </div>
                  <span class="product-toggle">
                    <span class="sr-only">Read more about {product.name}</span>
                    <i aria-hidden="true"></i>
                  </span>
                </summary>
                <div class="product-detail">
                  <p>{product.detail}</p>
                  <p>{product.terms}</p>
                  <a href={product.source} target="_blank" rel="noopener noreferrer">Product source ↗</a>
                </div>
              </details>
            ))
          }
        </div>
        <p class="ledger-note">
          Availability, price and terms can change. Information shown was reviewed
          <time datetime={site.reviewDate}>{site.reviewDateLabel}</time>. World Mobile’s
          checkout and current agreement control.
        </p>
      </div>
    </section>

    <section class="section rewards-section shell" id="rewards" aria-labelledby="rewards-title">
      <div class="section-heading">
        <div>
          <p class="section-index">04 / Rewards</p>
          <h2 id="rewards-title">Real activity first. Rewards second.</h2>
        </div>
        <p class="section-lede">
          These examples explain two different reward models. They are gross
          illustrations based on published terms—not forecasts, APY or guarantees.
        </p>
      </div>

      <div class="scenario-grid">
        <article class="scenario">
          <header>
            <span>Usage-linked example</span>
            <h3>EmberNode</h3>
          </header>
          <dl>
            <div><dt>Starting price</dt><dd>US$165</dd></div>
            <div><dt>Planning benchmark</dt><dd>~800 GB / month</dd></div>
            <div><dt>Published rate</dt><dd>~US$0.004167 / GB</dd></div>
            <div class="scenario-result"><dt>Illustrative gross reward</dt><dd>~US$3.33 / month</dd></div>
          </dl>
          <p>
            Actual throughput may be lower or higher. EmberNode does not connect
            end users directly; it distributes capacity downstream in Pakistan.
          </p>
          <a href={sources.ember} target="_blank" rel="noopener noreferrer">Check the EmberNode source ↗</a>
        </article>

        <article class="scenario">
          <header>
            <span>Service-linked example</span>
            <h3>Frontier Core</h3>
          </header>
          <dl>
            <div><dt>Previously published price</dt><dd>US$585</dd></div>
            <div><dt>Customer requirement</dt><dd>Active service</dd></div>
            <div><dt>Published activation window</dt><dd>Up to 60 days</dd></div>
            <div class="scenario-result"><dt>Published monthly base</dt><dd>US$17.55 when active</dd></div>
          </dl>
          <p>
            World Mobile publishes Frontier through scheduled drops. These figures
            explain the current model; confirm live batch availability and terms.
          </p>
          <a href={sources.frontier} target="_blank" rel="noopener noreferrer">Check the Frontier source ↗</a>
        </article>
      </div>

      <p class="scenario-disclaimer">
        Gross examples exclude tax, fees, downtime, maintenance, connectivity,
        currency movement, financing and other model-specific costs. Rewards may
        be lower than shown—or zero.
      </p>

      <div class="ownership-note">
        <div>
          <p class="section-index">What ownership means</p>
          <h3>What you own—and what you do not.</h3>
        </div>
        <p>
          World Mobile frames the purchase as ownership of telecom infrastructure.
          The agreement determines the legal title, hosting, operation, transfer
          rights and obligations. You do not buy equity in World Mobile, spectrum,
          land or a guaranteed income stream.
        </p>
      </div>
    </section>

    <section class="section risk-section" id="risks" aria-labelledby="risks-title">
      <div class="shell">
        <div class="risk-heading">
          <div>
            <p class="section-index">05 / Before you buy</p>
            <h2 id="risks-title">What could reduce or stop rewards?</h2>
          </div>
          <p>
            AirNodes are physical infrastructure, not savings products. Rewards
            depend on activation, verified usage or service, uptime, local
            operations and current terms.
          </p>
        </div>
        <div class="risk-list">
          {
            risks.map((risk, index) => (
              <details>
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{risk.title}</strong>
                  <i aria-hidden="true"></i>
                </summary>
                <p>{risk.body}</p>
              </details>
            ))
          }
        </div>
        <p class="risk-bottom-line">
          Read the current agreement and only commit capital you can afford to
          lock up or lose.
        </p>
      </div>
    </section>

    <aside class="affiliate-band" aria-labelledby="affiliate-title">
      <div class="shell affiliate-inner">
        <div>
          <p class="section-index">Independent affiliate guide</p>
          <h2 id="affiliate-title">Buy through World Mobile.</h2>
        </div>
        <div class="affiliate-copy">
          <p>
            Airnodes Club is independent from World Mobile. We may receive a
            commission after a qualifying first order is completed through our
            eligible referral link. World Mobile confirms availability,
            eligibility, price, any discount and the final agreement at checkout.
          </p>
          <a
            class="button button-light"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy AirNodes <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </aside>

    <section class="section faq-section shell" id="faq" aria-labelledby="faq-title">
      <div class="faq-heading">
        <p class="section-index">06 / Questions</p>
        <h2 id="faq-title">Plain answers before you buy.</h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details>
              <summary><span>{faq.question}</span><i aria-hidden="true"></i></summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="sources shell" aria-labelledby="sources-title">
      <div>
        <p class="section-index">Research record</p>
        <h2 id="sources-title">Check the source.</h2>
        <p>
          Information reviewed <time datetime={site.reviewDate}>{site.reviewDateLabel}</time>.
          Company-published figures have not been independently audited by Airnodes Club.
        </p>
      </div>
      <details>
        <summary>World Mobile first-party sources <i aria-hidden="true"></i></summary>
        <ul>
          {
            firstPartySources.map(([label, href]) => (
              <li><a href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a></li>
            ))
          }
        </ul>
      </details>
      <details>
        <summary>Independent, reseller and legacy context <i aria-hidden="true"></i></summary>
        <ul>
          {
            contextSources.map(([label, href]) => (
              <li><a href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a></li>
            ))
          }
        </ul>
        <p>
          Context only. The legacy knowledge base was not used for current product,
          pricing or reward claims.
        </p>
      </details>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <a class="brand" href="/" aria-label="Airnodes Club home"><BrandMark compact /></a>
      <p>Independent guide. Not operated by, endorsed by or part of World Mobile.</p>
      <nav aria-label="Footer navigation">
        <a href="#faq">Questions</a>
        <a href="#sources-title">Sources</a>
        <a href="#affiliate-title">Affiliate disclosure</a>
        <a href="#risks">Risk notice</a>
        <a href="https://github.com/its-me-julien/airnodes.club" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
      <p class="legal">
        Educational and marketing content only—not financial, tax or legal advice.
        AirNode ownership carries capital, operational, counterparty and regulatory
        risk. Earnings may be zero. The governing agreement determines legal title,
        rights and obligations. © {new Date().getFullYear()} Airnodes Club.
      </p>
    </div>
  </footer>
</Layout>
