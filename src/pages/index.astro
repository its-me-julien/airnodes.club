---
import { Image } from "astro:assets";
import BrandMark from "../components/BrandMark.astro";
import OperatorDashboard from "../components/OperatorDashboard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import heroImage from "../assets/airnode-operator.png";
import Layout from "../layouts/Layout.astro";
import { products, site } from "../config";

const steps = [
  {
    number: "01",
    title: "Choose an AirNode",
    body: "Compare what it does, where it is available, who operates it and the current terms.",
  },
  {
    number: "02",
    title: "Buy and sign",
    body: "Complete your order with World Mobile and sign the current Operator agreement.",
  },
  {
    number: "03",
    title: "Deploy and activate",
    body: "The AirNode is installed and connected. Who handles this depends on the model and agreement.",
  },
  {
    number: "04",
    title: "Track and earn rewards",
    body: "Follow your AirNode, see how it is used and track the rewards it earns in the AirNode dashboard.",
  },
] as const;

const risks = [
  {
    title: "Demand and traffic",
    body: "For usage-linked AirNodes, stronger demand and more network activity can lead to better rewards. How rewards are calculated depends on your AirNode type.",
  },
  {
    title: "Activation and uptime",
    body: "Rewards may begin once your AirNode is active. Paused service or an unavailable connection can affect the rewards it earns.",
  },
  {
    title: "Hardware status",
    body: "Keeping the equipment operational helps it continue providing service. Damage, maintenance, replacement or relocation can temporarily affect rewards.",
  },
  {
    title: "Terms and local requirements",
    body: "Each AirNode operates under current product terms and local telecom requirements. These can shape availability and how rewards are calculated.",
  },
] as const;

---

<Layout
  title="Airnodes Club | Own telecom infrastructure"
  description="A clear guide to World Mobile AirNodes. Learn what each model does, who operates it, how rewards work and what to check before you buy."
>
  <header class="site-header">
    <nav class="shell nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="Airnodes Club home">
        <BrandMark />
      </a>
      <div class="nav-links">
        <a href="#how-it-works">How it works</a>
        <a href="#airnodes">AirNodes</a>
        <a href="#rewards">Rewards &amp; risks</a>
      </div>
      <a
        class="button button-small button-primary"
        href={site.affiliateUrl}
        target="_blank"
        rel="sponsored noopener noreferrer"
      >
        Buy AirNodes <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Own the infrastructure that keeps people connected.</h1>
        <p class="hero-lede">
          Explore World Mobile AirNodes, understand how each model works, and see
          how rewards are earned.
        </p>
        <div class="hero-actions">
          <a
            class="button button-light"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy AirNodes <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="micro-disclosure">
          Independent affiliate guide. We may earn a commission from qualifying
          purchases.
        </p>
      </div>
      <figure class="hero-media">
        <Image
          src={heroImage}
          alt="A network technician working beside outdoor telecom equipment above a neighbourhood"
          widths={[720, 960, 1280, 1600]}
          sizes="(max-width: 860px) 100vw, 55vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          AirNode hardware is deployed where people need connectivity.
        </figcaption>
      </figure>
    </section>

    <section class="section intro-section shell" id="start" aria-labelledby="start-title">
      <div class="section-heading">
        <div>
          <p class="section-index">01 / Start here</p>
          <h2 id="start-title">A different way to build a mobile network.</h2>
        </div>
        <p class="section-lede">
          World Mobile brings together telecom infrastructure, local operations and
          ownership by everyday people. Anyone can help build the network.
        </p>
      </div>

      <div class="definition-list">
        <article>
          <p class="definition-label">World Mobile</p>
          <div>
            <h3>The network</h3>
            <p>
              World Mobile brings together the network, AirNode platform and local
              partners that deliver mobile and internet service.
            </p>
          </div>
        </article>
        <article>
          <p class="definition-label">AirNode</p>
          <div>
            <h3>The physical infrastructure</h3>
            <p>
              Each AirNode has a specific job. It can move data, connect a business,
              extend coverage or support the wider network.
            </p>
          </div>
        </article>
        <article>
          <p class="definition-label">Operator</p>
          <div>
            <h3>The owner</h3>
            <p>
              World Mobile calls an AirNode owner an Operator. Your agreement explains
              who installs and runs it, and how eligible rewards are calculated.
            </p>
          </div>
        </article>
      </div>

      <div class="ownership-statement">
        <p>You own infrastructure that helps connect people.</p>
        <p>You can earn rewards when it supports real network activity.</p>
      </div>
    </section>

    <section class="journey-section" id="how-it-works" aria-labelledby="journey-title">
      <div class="shell">
        <div class="journey-heading">
          <p class="section-index">02 / How it works</p>
          <h2 id="journey-title">From choosing to earning rewards in four steps.</h2>
        </div>
        <ol class="journey-list">
          {
            steps.map((step) => (
              <li>
                <span class="step-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
        <div class="reward-logic">
          <p class="reward-logic-title">Rewards come from delivering real service.</p>
          <p class="reward-logic-copy">
            Each AirNode plays a different role. Portal and Spark connect people and
            businesses. EmberNode moves capacity through the network. All of them help
            data reach the places where it is needed. Rewards depend on the model and
            its qualifying activity. More real use can mean more rewards, but earnings
            are never guaranteed.
          </p>
        </div>
      </div>
    </section>

    <section class="section dashboard-section" id="dashboard" aria-labelledby="dashboard-title">
      <div class="shell">
        <div class="section-heading dashboard-section-heading">
          <div>
            <p class="section-index">03 / Your dashboard</p>
            <h2 id="dashboard-title">See how your AirNodes are performing.</h2>
          </div>
          <p class="section-lede">
            Follow network activity, monitor performance and track rewards from one
            operator dashboard.
          </p>
        </div>
        <OperatorDashboard />
      </div>
    </section>

    <section class="section product-section" id="airnodes" aria-labelledby="airnodes-title">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="section-index">04 / The options</p>
            <h2 id="airnodes-title">Choose the AirNode that fits your operator profile.</h2>
          </div>
          <p class="section-lede">
            AirNodes are deployed in different places and perform different jobs
            across the network. Published prices range from about US$63 to US$100,000,
            while operating needs and reward models vary. Compare them to find the
            right fit for you.
          </p>
        </div>

        <div class="product-ledger">
          {
            products.map((product) => (
              <details class="product-row">
                <summary>
                  <div class="product-name">
                    <h3>{product.name}</h3>
                  </div>
                  <div class="product-service">
                    <span class="cell-label">Service provided</span>
                    <strong>{product.service}</strong>
                  </div>
                  <div class="product-location">
                    <span class="cell-label">Where</span>
                    <strong>{product.location}</strong>
                  </div>
                  <div class="product-economics">
                    <span class="cell-label">Price</span>
                    <strong>{product.price}</strong>
                  </div>
                  <span class="product-toggle">
                    <span class="sr-only">Read more about {product.name}</span>
                    <i aria-hidden="true"></i>
                  </span>
                </summary>
                <div class="product-detail">
                  <div>
                    <span class="cell-label">How rewards work</span>
                    <p>{product.reward}</p>
                  </div>
                  <a
                    class="button button-small button-primary"
                    href={site.affiliateUrl}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                  >
                    {product.cta} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section rewards-section shell" id="rewards" aria-labelledby="rewards-title">
      <div class="section-heading">
        <div>
          <p class="section-index">05 / Rewards</p>
          <h2 id="rewards-title">How each AirNode earns.</h2>
        </div>
        <p class="section-lede">
          AirNodes earn according to the service they provide. Compare how Spark,
          EmberNode, Frontier and Portal generate rewards.
        </p>
      </div>

      <div class="scenario-grid">
        <article class="scenario">
          <header>
            <h3>Spark</h3>
          </header>
          <dl>
            <div><dt>Service</dt><dd>Local Wi-Fi coverage</dd></div>
            <div><dt>Reward model</dt><dd>Fixed monthly</dd></div>
            <div class="scenario-result"><dt>Rewards expectations*</dt><dd>US$1.70 / month</dd></div>
          </dl>
          <a
            class="button button-small button-primary"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy Spark <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="scenario">
          <header>
            <h3>EmberNode</h3>
          </header>
          <dl>
            <div><dt>Service</dt><dd>Network data distribution</dd></div>
            <div><dt>Reward model</dt><dd>Verified network traffic</dd></div>
            <div class="scenario-result"><dt>Rewards expectations*</dt><dd>~US$3.33 / month</dd></div>
          </dl>
          <a
            class="button button-small button-primary"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy EmberNode <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="scenario">
          <header>
            <h3>Frontier</h3>
          </header>
          <dl>
            <div><dt>Service</dt><dd>Business Wi-Fi</dd></div>
            <div><dt>Reward model</dt><dd>Fixed monthly base</dd></div>
            <div class="scenario-result"><dt>Rewards expectations*</dt><dd>US$17.55 to US$58.50 / month</dd></div>
          </dl>
          <a
            class="button button-small button-primary"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy Frontier <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="scenario">
          <header>
            <h3>Portal</h3>
          </header>
          <dl>
            <div><dt>Service</dt><dd>Wide-area coverage</dd></div>
            <div><dt>Reward model</dt><dd>Subscriber and usage linked</dd></div>
            <div class="scenario-result"><dt>Rewards expectations*</dt><dd>US$250 to US$500 / month</dd></div>
          </dl>
          <a
            class="button button-small button-primary"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy Portal <span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>

      <p class="scenario-disclaimer">
        *Reward figures reflect World Mobile’s latest information, but they are not a
        guarantee of rewards. Actual rewards depend on the AirNode type, activation
        status, network usage, location and other factors. Earnings can vary and may
        be zero.
      </p>

    </section>

    <section class="section risk-section" id="risks" aria-labelledby="risks-title">
      <div class="shell">
        <div class="risk-heading">
          <div>
            <p class="section-index">06 / Before you buy</p>
            <h2 id="risks-title">What shapes your rewards?</h2>
          </div>
          <p>
            Strong performance starts with the right location, an active connection
            and reliable equipment. Here are the factors that matter most.
          </p>
        </div>
        <div class="risk-list">
          {
            risks.map((risk, index) => (
              <details>
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{risk.title}</strong>
                  <i aria-hidden="true"></i>
                </summary>
                <p>{risk.body}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section deployment-section" id="regions" aria-labelledby="regions-title">
      <div class="shell">
        <div class="section-heading deployment-heading">
          <div>
            <p class="section-index">07 / Deployment regions</p>
            <h2 id="regions-title">Built around real places and real demand.</h2>
          </div>
          <p class="section-lede">
            Every rollout begins with local partners, physical infrastructure and a
            clear need for better connectivity.
          </p>
        </div>

        <div class="region-list">
          <article class="region-story">
            <div class="region-intro">
              <span class="region-number">01</span>
              <p class="region-product">Frontier AirNodes</p>
              <h3>Siargao, Philippines</h3>
            </div>
            <div class="region-detail">
              <p class="region-summary">
                Frontier is being deployed around General Luna and toward Cloud 9,
                where hotels, cafés, shops, homes and visitors create concentrated
                demand for reliable internet.
              </p>
              <div class="deployment-path" aria-label="Siargao deployment path">
                <span>Fibre and backhaul</span><i aria-hidden="true"></i>
                <span>Frontier AirNodes</span><i aria-hidden="true"></i>
                <span>Business and public Wi-Fi</span>
              </div>
              <dl class="region-facts">
                <div><dt>Starting area</dt><dd>General Luna to Cloud 9</dd></div>
                <div><dt>Local operations</dt><dd>CWC, trading as eSari-Sari</dd></div>
                <div><dt>Network role</dt><dd>Fibre-backed connectivity at homes and businesses</dd></div>
              </dl>
            </div>
          </article>

          <article class="region-story">
            <div class="region-intro">
              <span class="region-number">02</span>
              <p class="region-product">EmberNode + Spark</p>
              <h3>Pakistan</h3>
            </div>
            <div class="region-detail">
              <p class="region-summary">
                World Mobile and WorldCall are expanding the network from backbone
                distribution to local access. EmberNode moves capacity through the
                network; Spark brings connectivity closer to people and businesses.
              </p>
              <div class="deployment-path" aria-label="Pakistan deployment path">
                <span>Fibre backbone</span><i aria-hidden="true"></i>
                <span>EmberNode distribution</span><i aria-hidden="true"></i>
                <span>Spark at the edge</span>
              </div>
              <dl class="region-facts">
                <div><dt>Active cities</dt><dd>Islamabad, Lahore, Faisalabad and Multan</dd></div>
                <div><dt>Local partner</dt><dd>WorldCall</dd></div>
                <div><dt>Network role</dt><dd>Distribution capacity and last-mile Wi-Fi</dd></div>
              </dl>
            </div>
          </article>
        </div>

        <p class="deployment-statement">
          Local partners. Infrastructure on the ground. Demand already present.
        </p>
      </div>
    </section>

    <aside class="affiliate-band" aria-labelledby="affiliate-title">
      <div class="shell affiliate-inner">
        <div>
          <h2 id="affiliate-title">Buy through World Mobile.</h2>
        </div>
        <div class="affiliate-copy">
          <p>
            Airnodes Club is independent from World Mobile. We may receive a
            commission after a qualifying first order is completed through our
            eligible referral link.
          </p>
          <a
            class="button button-light"
            href={site.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            Buy AirNodes <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </aside>

  </main>

  <SiteFooter />
</Layout>
