---
import GuidePage from "../../components/GuidePage.astro";
export const prerender = true;
export function getStaticPaths() {
const regions = {
  philippines: { title:"World Mobile AirNodes in the Philippines | Airnodes Club", description:"Learn how World Mobile Frontier AirNodes are being deployed around General Luna and Cloud 9 in Siargao, Philippines.", eyebrow:"Deployment region / Philippines", heading:"Frontier AirNodes in Siargao.", intro:"The first commercial Frontier deployment is concentrated around General Luna and toward Cloud 9, where hospitality, retail and visitor activity create clear demand for reliable internet.", facts:[{label:"AirNode",value:"Frontier"},{label:"Starting area",value:"General Luna to Cloud 9"},{label:"Local operations",value:"CWC / eSari-Sari"},{label:"Network role",value:"Fibre-backed business Wi-Fi"}], path:["Fibre and backhaul","Frontier AirNodes","Business and public Wi-Fi"], sections:[{title:"Infrastructure comes first",body:"The rollout begins with fibre, backhaul and local operating capability—not an isolated device sale. That foundation supports Frontier AirNodes installed at active homes and businesses around the initial deployment area."},{title:"Why Siargao",body:"General Luna concentrates hotels, cafés, surf shops, homes, visitors and remote workers in one commercially active area. Reliable internet supports payments, bookings, communications and the everyday services that keep the local economy moving."},{title:"A network designed to expand",body:"As deployment density grows, individual business connections can contribute to a wider local Wi-Fi layer. Siargao also provides a practical model that World Mobile and its partners can adapt for future locations in the Philippines."}], related:[{href:"/airnodes/frontier/",label:"Frontier AirNode",description:"Compare its service, price and current reward structure."},{href:"/deployment-regions/pakistan/",label:"Pakistan network",description:"See a different deployment from backbone to network edge."},{href:"/airnode-affiliate-code/",label:"Affiliate code JWBMLA",description:"Understand how the World Mobile referral link works."}], ctaLabel:"Explore Frontier AirNodes", parent:{href:"/#regions",label:"Deployment regions"}},
  pakistan: { title:"World Mobile AirNodes in Pakistan | Airnodes Club", description:"Learn how Spark and EmberNode support World Mobile network expansion with WorldCall across Pakistan.", eyebrow:"Deployment region / Pakistan", heading:"AirNodes across Pakistan’s network path.", intro:"World Mobile and WorldCall combine fibre infrastructure, EmberNode distribution and Spark Wi-Fi coverage to move capacity from the backbone toward people and businesses.", facts:[{label:"AirNodes",value:"EmberNode and Spark"},{label:"Active cities",value:"Islamabad, Lahore, Faisalabad and Multan"},{label:"Local partner",value:"WorldCall"},{label:"Network role",value:"Distribution and local Wi-Fi"}], path:["WorldCall fibre backbone","EmberNode distribution","Spark at the edge"], sections:[{title:"Backbone and distribution",body:"EmberNode sits higher in the network path, helping carry capacity through fibre enclosures, cabinets and distribution points. This layer creates the foundation required to support more connectivity at the edge."},{title:"Connectivity reaches the edge",body:"Spark creates local Wi-Fi coverage closer to people, homes and businesses. Together, EmberNode and Spark show how different AirNodes contribute to one connected network rather than operating as isolated products."},{title:"Why Pakistan",body:"Pakistan combines growing demand for mobile data and internet access with WorldCall’s established fibre footprint and local operating experience. As distribution capacity expands, more edge connectivity can be supported across active cities and future service areas."}], related:[{href:"/airnodes/embernode/",label:"EmberNode",description:"Understand distribution-layer ownership and traffic-linked rewards."},{href:"/airnodes/spark/",label:"Spark AirNode",description:"Explore local Wi-Fi coverage and current reward structure."},{href:"/deployment-regions/philippines/",label:"Philippines rollout",description:"Compare Pakistan’s network path with Frontier in Siargao."}], ctaLabel:"Explore Pakistan AirNodes", parent:{href:"/#regions",label:"Deployment regions"}},
} as const;
return Object.entries(regions).map(([slug, props]) => ({params:{slug},props}));
}
const region = Astro.props;
---
<GuidePage {...region} />
