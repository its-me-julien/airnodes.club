{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "airnodes-club",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
